# SolutionBridge Environment Configuration

# Application
APP_NAME=SolutionBridge
APP_ENV=development
PORT=8000
DEBUG=True
LOG_LEVEL=INFO

# Database Configuration
# Primary Production / Docker Database (MySQL 8):
DATABASE_URL=mysql+pymysql://root:rootpassword@localhost:3306/solutionbridge

# Optional Explicit Development Mode (SQLite):
# DATABASE_URL=sqlite:///./solutionbridge.db

# Security & API Keys
SECRET_KEY=solutionbridge-insecure-secret-key-change-in-prod-xyz789
API_KEY_HEADER=X-API-Key

# Machine Learning Artifacts Path
ML_ARTIFACTS_DIR=ml/artifacts

# Streamlit Dashboard
STREAMLIT_PORT=8501
BACKEND_API_URL=http://localhost:8000

# Optional OpenAI Layer (Falls back deterministically if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
